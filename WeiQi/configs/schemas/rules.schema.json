{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Go Rules Configuration",
  "description": "围棋游戏规则配置",
  "type": "object",
  "required": ["turn_order", "win_conditions"],
  "properties": {
    "_metadata": {
      "type": "object",
      "description": "元数据"
    },
    "turn_order": {
      "type": "object",
      "description": "回合顺序",
      "required": ["sequence"],
      "properties": {
        "sequence": {
          "type": "array",
          "description": "回合序列",
          "items": {
            "type": "string",
            "enum": ["black", "white"]
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "skip_if_no_valid_moves": {
          "type": "boolean",
          "description": "无合法手时是否跳过"
        }
      }
    },
    "ko_rule": {
      "type": "object",
      "description": "打劫规则",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "是否启用打劫规则"
        },
        "type": {
          "type": "string",
          "enum": ["simple", "superko"],
          "description": "打劫类型：simple（简单打劫）或 superko（全局同形禁止）"
        }
      }
    },
    "suicide_rule": {
      "type": "object",
      "description": "自杀规则",
      "properties": {
        "allowed": {
          "type": "boolean",
          "description": "是否允许自杀（自杀即落子后己方无气）"
        }
      }
    },
    "scoring": {
      "type": "object",
      "description": "计分规则",
      "properties": {
        "method": {
          "type": "string",
          "enum": ["area", "territory"],
          "description": "计分方法：area（数目法）或 territory（数子法）"
        },
        "komi": {
          "type": "number",
          "description": "贴目（白方额外得分）"
        }
      }
    },
    "win_conditions": {
      "type": "object",
      "description": "胜利条件配置",
      "properties": {
        "double_pass": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "双方虚手后是否终局"
            }
          }
        },
        "capture_all": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "吃光对方所有棋子是否获胜"
            }
          }
        },
        "resign": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "是否允许认输"
            }
          }
        }
      }
    },
    "handicap": {
      "type": "object",
      "description": "让子设置",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "stones": {
          "type": "integer",
          "minimum": 0
        },
        "positions": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              { "type": "integer" },
              { "type": "integer" }
            ]
          }
        }
      }
    },
    "ai": {
      "type": "object",
      "description": "AI配置",
      "properties": {
        "default_difficulty": {
          "type": "string",
          "enum": ["easy", "medium", "hard"],
          "description": "默认难度"
        },
        "search_depth": {
          "type": "integer",
          "minimum": 1,
          "description": "搜索深度"
        },
        "personality": {
          "type": "object",
          "description": "AI性格参数",
          "properties": {
            "aggressiveness": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "进攻性 0-100"
            },
            "defensiveness": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "防守性 0-100"
            },
            "territory_weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "地盘权重 0-100"
            },
            "risk_taking": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "冒险性 0-100"
            }
          }
        }
      }
    },
    "custom_rules": {
      "type": "array",
      "description": "自定义规则列表（自然语言描述，供AI执行）",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "active": { "type": "boolean" },
          "rule_text": { "type": "string" }
        },
        "required": ["id", "rule_text", "active"]
      }
    }
  },
  "additionalProperties": true
}
