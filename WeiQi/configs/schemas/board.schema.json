{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Go Board Configuration",
  "description": "围棋棋盘配置",
  "type": "object",
  "required": ["geometry"],
  "properties": {
    "_metadata": {
      "type": "object",
      "description": "元数据"
    },
    "geometry": {
      "type": "object",
      "description": "棋盘几何配置",
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "棋盘宽度（列数）"
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "棋盘高度（行数）"
        },
        "star_points": {
          "type": "array",
          "description": "星位坐标列表",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              { "type": "integer", "minimum": 0 },
              { "type": "integer", "minimum": 0 }
            ]
          }
        }
      }
    },
    "appearance": {
      "type": "object",
      "description": "棋盘外观配置",
      "properties": {
        "background_color": {
          "type": "string",
          "description": "棋盘背景颜色"
        },
        "line_color": {
          "type": "string",
          "description": "棋盘线条颜色"
        },
        "star_points": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "radius": { "type": "number", "minimum": 0 },
            "color": { "type": "string" }
          }
        },
        "custom_style": {
          "type": "string",
          "description": "自定义CSS样式"
        },
        "background_image": {
          "type": "string",
          "description": "背景图片URL或data URI"
        }
      }
    },
    "regions": {
      "type": "object",
      "description": "命名区域定义，供规则条件引用",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "cells": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": [
                { "type": "integer", "minimum": 0 },
                { "type": "integer", "minimum": 0 }
              ]
            }
          },
          "rows": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "cols": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "bounds": {
            "type": "object",
            "properties": {
              "x_min": { "type": "integer" },
              "x_max": { "type": "integer" },
              "y_min": { "type": "integer" },
              "y_max": { "type": "integer" }
            }
          }
        }
      }
    },
    "initial_setup": {
      "type": "object",
      "description": "初始配置（可选，默认为空盘）",
      "properties": {
        "pieces": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "side": { "type": "string", "enum": ["black", "white"] },
              "position": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": [
                  { "type": "integer" },
                  { "type": "integer" }
                ]
              }
            },
            "required": ["type", "side", "position"]
          }
        }
      }
    }
  },
  "additionalProperties": true
}
