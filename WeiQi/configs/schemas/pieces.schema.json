{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "围棋棋子配置（单阵营）",
  "description": "place/capture/liberty 原语体系的棋子规则配置",
  "type": "object",
  "properties": {
    "_metadata": {
      "type": "object"
    },
    "pieces": {
      "type": "object",
      "description": "标准棋子类型定义",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "object",
            "description": "棋子显示标签（黑白方各一个）",
            "properties": {
              "black": { "type": "string" },
              "white": { "type": "string" }
            },
            "required": ["black", "white"]
          },
          "is_king": {
            "type": "boolean",
            "description": "是否是王/帅类棋子（影响胜负判断）"
          },
          "stone_value": {
            "type": "number",
            "description": "棋子价值评估分数，用于AI评估"
          },
          "place_rules": {
            "type": "array",
            "description": "落子规则列表",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": ["place"],
                  "description": "原语类型：place（落子）"
                },
                "land": {
                  "enum": ["empty"],
                  "description": "落点要求：empty（空点）"
                },
                "where": {
                  "type": "array",
                  "description": "条件表达式列表",
                  "items": {
                    "type": "object",
                    "properties": {
                      "in_region": {
                        "oneOf": [
                          { "type": "string" },
                          {
                            "type": "object",
                            "properties": {
                              "pos": { "enum": ["$dest", "$self"] },
                              "region": { "type": "string" }
                            },
                            "required": ["pos", "region"]
                          }
                        ]
                      },
                      "at_row": {
                        "oneOf": [
                          { "type": "integer" },
                          {
                            "type": "object",
                            "properties": {
                              "pos": { "enum": ["$dest", "$self"] },
                              "row": { "type": "integer" }
                            },
                            "required": ["pos", "row"]
                          }
                        ]
                      },
                      "at_col": {
                        "oneOf": [
                          { "type": "integer" },
                          {
                            "type": "object",
                            "properties": {
                              "pos": { "enum": ["$dest", "$self"] },
                              "col": { "type": "integer" }
                            },
                            "required": ["pos", "col"]
                          }
                        ]
                      },
                      "not": { "type": "object" },
                      "and": { "type": "array" },
                      "or": { "type": "array" }
                    },
                    "minProperties": 1,
                    "maxProperties": 1
                  }
                }
              },
              "required": ["kind", "land"]
            }
          },
          "capture_rules": {
            "type": "array",
            "description": "提子规则列表",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": ["capture"],
                  "description": "原语类型：capture（提子）"
                },
                "condition": {
                  "enum": ["no_liberties"],
                  "description": "提子条件：no_liberties（无气则提）"
                },
                "target": {
                  "enum": ["enemy"],
                  "description": "提子目标：enemy（敌方）"
                }
              },
              "required": ["kind", "condition", "target"]
            }
          },
          "liberty_rules": {
            "type": "object",
            "description": "气的计算规则",
            "properties": {
              "count_method": {
                "enum": ["orthogonal_adjacent", "8_adjacent"],
                "description": "气数计算方法"
              },
              "group_connect": {
                "enum": ["orthogonal", "8_connected"],
                "description": "棋组连接方式"
              }
            },
            "required": ["count_method", "group_connect"]
          }
        },
        "required": ["label", "place_rules", "capture_rules", "liberty_rules"]
      }
    },
    "side_overrides": {
      "type": "object",
      "properties": {
        "white": { "type": "object" },
        "black": { "type": "object" }
      }
    },
    "custom_pieces": {
      "type": "array",
      "description": "自定义棋子类型",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "棋子类型标识符",
            "minLength": 1
          },
          "label": {
            "type": "object",
            "properties": {
              "black": { "type": "string" },
              "white": { "type": "string" }
            },
            "required": ["black", "white"]
          },
          "is_king": { "type": "boolean" },
          "stone_value": { "type": "number" },
          "place_rules": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": { "enum": ["place"] },
                "land": { "enum": ["empty"] },
                "where": { "type": "array" }
              },
              "required": ["kind", "land"]
            }
          },
          "capture_rules": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": { "enum": ["capture"] },
                "condition": { "enum": ["no_liberties"] },
                "target": { "enum": ["enemy"] }
              },
              "required": ["kind", "condition", "target"]
            }
          },
          "liberty_rules": {
            "type": "object",
            "properties": {
              "count_method": { "enum": ["orthogonal_adjacent", "8_adjacent"] },
              "group_connect": { "enum": ["orthogonal", "8_connected"] }
            },
            "required": ["count_method", "group_connect"]
          }
        },
        "required": ["type", "label", "place_rules", "capture_rules", "liberty_rules"]
      }
    }
  },
  "required": ["pieces"]
}
