  ],
  "variables": {},
  "start_scene_id": "scene_1",
  "scenes": [
    {
      "id": "scene_1",
      "name": "课间·五子棋",
      "start_node_id": "n1",
      "nodes": [
        { "id": "n1", "type": "bg", "data": { "bg_id": "bg_classroom", "transition": "fade", "next": "n2" } },
        { "id": "n2", "type": "narration", "data": { "text": "午休时间，阳光透过窗户洒进教室。小明趴在课桌上，面前摆着一张五子棋棋盘。", "next": "n3" } },
        { "id": "n3", "type": "show_char", "data": { "character_id": "boy", "expression": "determined", "position": "center", "transition": "fade", "next": "n4" } },
        { "id": "n4", "type": "dialogue", "data": { "character_id": "boy", "expression": "determined", "text": "再来！这次我一定能赢！", "next": "n5" } },
        { "id": "n5", "type": "narration", "data": { "text": "同桌小刚嘿嘿一笑，落下一枚黑子。小明执白，紧张地盯着棋盘。", "next": "n6" } },
        { "id": "n6", "type": "dialogue", "data": { "character_id": "boy", "expression": "thinking", "text": "等等，他这步……又要形成双三了！", "next": "n7" } },
        { "id": "n7", "type": "narration", "data": { "text": "小明慌忙防守，但已经来不及了。小刚连下几子，五子连珠。", "next": "n8" } },
        { "id": "n8", "type": "dialogue", "data": { "character_id": "boy", "expression": "defeated", "text": "又输了……这是第几把了？", "next": "n9" } },
        { "id": "n9", "type": "narration", "data": { "text": "小刚得意地数着手指：「第十三把了。小明，你是不是偷偷练棋了？进步挺快的——虽然还是赢不了我。」", "next": "n10" } },
        { "id": "n10", "type": "dialogue", "data": { "character_id": "boy", "expression": "sad", "text": "可恶……明明已经很努力了，为什么总是差一点……", "next": "n11" } },
        { "id": "n11", "type": "narration", "data": { "text": "一股怒火从小明胸口涌起，他猛地站起身——", "next": "n12" } },
        { "id": "n12", "type": "dialogue", "data": { "character_id": "boy", "expression": "determined", "text": "再来！我就不信赢不了你！", "next": "n13" } },
        { "id": "n13", "type": "narration", "data": { "text": "然而第十四局，依然是同样的结局。小明盯着棋盘，眼前渐渐模糊——", "next": "n14" } },
        { "id": "n14", "type": "dialogue", "data": { "character_id": "boy", "expression": "surprised", "text": "头……好晕……", "next": "n15" } },
        { "id": "n15", "type": "hide_char", "data": { "character_id": "boy", "transition": "fade", "next": "n16" } },
        { "id": "n16", "type": "narration", "data": { "text": "小明眼前一黑，直直地倒了下去。", "next": "n17" } },
        { "id": "n17", "type": "jump", "data": { "target_scene_id": "scene_2", "target_node_id": "s2_n1" } }
      ]
    },
    {
      "id": "scene_2",
      "name": "觉醒·棋圣系统",
      "start_node_id": "s2_n1",
      "nodes": [
        { "id": "s2_n1", "type": "bg", "data": { "bg_id": "bg_dream", "transition": "fade", "next": "s2_n2" } },
        { "id": "s2_n2", "type": "narration", "data": { "text": "意识沉入一片幽蓝的虚空。无数光点在周围旋转，像是散落的棋子。", "next": "s2_n3" } },
        { "id": "s2_n3", "type": "show_char", "data": { "character_id": "robot", "expression": "front_idle", "position": "center", "transition": "fade", "next": "s2_n4" } },
        { "id": "s2_n4", "type": "dialogue", "data": { "character_id": "robot", "expression": "scheming", "text": "检测到强烈的求胜欲望……符合觉醒条件。", "next": "s2_n5" } },
        { "id": "s2_n5", "type": "dialogue", "data": { "character_id": "robot", "expression": "front_idle", "text": "我是棋圣系统。我能让你赢得每一局棋——用一种……特殊的方式。", "next": "s2_n6" } },
        { "id": "s2_n6", "type": "dialogue", "data": { "character_id": "robot", "expression": "scheming", "text": "我可以改写棋局规则，改变对手的认知，让你的作弊看起来天衣无缝。", "next": "s2_n7" } },
        { "id": "s2_n7", "type": "dialogue", "data": { "character_id": "robot", "expression": "thinking", "text": "但每次改写都要消耗能量，并且……有被识破的风险。", "next": "s2_n8" } },
        { "id": "s2_n8", "type": "dialogue", "data": { "character_id": "boy", "expression": "surprised", "position": "left", "transition": "fade", "text": "你……是谁？这是什么地方？", "next": "s2_n9" } },
        { "id": "s2_n9", "type": "dialogue", "data": { "character_id": "robot", "expression": "laughing", "text": "我是寄宿在你意识中的AI。至于这里——是你的潜意识深处。", "next": "s2_n10" } },
        { "id": "s2_n10", "type": "dialogue", "data": { "character_id": "robot", "expression": "scheming", "text": "你愿意接受我的力量吗？接受它，你就能改写规则；拒绝它……你依然只是那个连输十三把的少年。", "next": "s2_n11" } },
        { "id": "s2_n11", "type": "choice", "data": { "options": [
          { "text": "接受力量", "next_scene_id": "scene_3", "next_node_id": "s3_accept" },
          { "text": "拒绝", "next_scene_id": "scene_3", "next_node_id": "s3_refuse" }
        ] } }
      ]
    },
    {
      "id": "scene_3",
      "name": "抉择",
      "start_node_id": "s3_accept",
      "nodes": [
        { "id": "s3_accept", "type": "dialogue", "data": { "character_id": "robot", "expression": "laughing", "text": "很好。从此刻起，棋圣系统正式激活。", "next": "s3_jump" } },
        { "id": "s3_refuse", "type": "dialogue", "data": { "character_id": "robot", "expression": "scheming", "text": "你会回来的。没有人能拒绝胜利的诱惑。棋圣系统将在你需要时待命。", "next": "s3_jump" } },
        { "id": "s3_jump", "type": "jump", "data": { "target_scene_id": "scene_4", "target_node_id": "s4_n1" } }
      ]
    },
    {
      "id": "scene_4",
      "name": "苏醒",
      "start_node_id": "s4_n1",
      "nodes": [
        { "id": "s4_n1", "type": "bg", "data": { "bg_id": "bg_wake", "transition": "fade", "next": "s4_n2" } },
        { "id": "s4_n2", "type": "narration", "data": { "text": "小明猛地睁开眼睛，发现自己正躺在教室的课桌上。同桌小刚正担忧地看着他。", "next": "s4_n3" } },
        { "id": "s4_n3", "type": "show_char", "data": { "character_id": "boy", "expression": "surprised", "position": "center", "transition": "fade", "next": "s4_n4" } },
        { "id": "s4_n4", "type": "dialogue", "data": { "character_id": "boy", "expression": "surprised", "text": "……我睡着了？", "next": "s4_n5" } },
        { "id": "s4_n5", "type": "narration", "data": { "text": "小刚松了口气：「你刚才突然晕倒了，吓死我了！要不要去医务室？」", "next": "s4_n6" } },
        { "id": "s4_n6", "type": "dialogue", "data": { "character_id": "boy", "expression": "thinking", "text": "不用了……我没事。", "next": "s4_n7" } },
        { "id": "s4_n7", "type": "narration", "data": { "text": "小刚走后，小明独自坐在座位上，耳边忽然响起一个冰冷的声音——", "next": "s4_n8" } },
        { "id": "s4_n8", "type": "dialogue", "data": { "character_id": "robot", "expression": "scheming", "text": "棋圣系统已就绪。当你需要时，说出你的第一个指令。", "next": "s4_n9" } },
        { "id": "s4_n9", "type": "dialogue", "data": { "character_id": "boy", "expression": "determined", "text": "……再来一局。这次，我一定要赢。", "next": "s4_n10" } },
        { "id": "s4_n10", "type": "end", "data": { "ending_type": "neutral", "text": "序章·觉醒 完" } }
      ]
    }
  ]
}