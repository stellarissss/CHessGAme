  "scenes": [
    {
      "id": "scene_1",
      "name": "棋圣世界·新手村",
      "start_node_id": "n1",
      "nodes": [
        { "id": "n1", "type": "bg", "data": { "bg_id": "bg_village", "transition": "fade", "next": "n2" } },
        { "id": "n2", "type": "narration", "data": { "text": "一阵眩晕过后，小明发现自己置身于一个陌生的世界。空中漂浮着巨大的棋盘碎片，地面由黑白格子铺成。", "next": "n3" } },
        { "id": "n3", "type": "show_char", "data": { "character_id": "boy", "expression": "surprised", "position": "center", "transition": "fade", "next": "n4" } },
        { "id": "n4", "type": "dialogue", "data": { "character_id": "boy", "expression": "surprised", "text": "这是……哪里？", "next": "n5" } },
        { "id": "n5", "type": "dialogue", "data": { "character_id": "robot", "expression": "scheming", "text": "欢迎来到棋圣世界。这里是新手村——所有觉醒棋圣系统的棋手，都从这里开始他们的旅程。", "next": "n6" } },
        { "id": "n6", "type": "show_char", "data": { "character_id": "robot", "expression": "front_idle", "position": "center", "transition": "fade", "next": "n7" } },
        { "id": "n7", "type": "dialogue", "data": { "character_id": "robot", "expression": "front_idle", "text": "我观察了你的表现——你在教室里展现出的求胜欲望，远超常人。你是个下棋的好苗子。", "next": "n8" } },
        { "id": "n8", "type": "dialogue", "data": { "character_id": "robot", "expression": "laughing", "text": "所以，我决定将你带到这里。在棋圣世界，你将面对更强的对手，学习更深的棋道。", "next": "n9" } },
        { "id": "n9", "type": "dialogue", "data": { "character_id": "boy", "expression": "thinking", "text": "更强的对手？那小刚……他算什么？", "next": "n10" } },
        { "id": "n10", "type": "dialogue", "data": { "character_id": "robot", "expression": "scheming", "text": "小刚只是你人生的起点。这里的守棋人，每一个都曾是人间的棋道高手。", "next": "n11" } },
        { "id": "n11", "type": "narration", "data": { "text": "远处走来一个身影，他身后背着一副巨大的象棋棋盘，目光如炬。", "next": "n12" } },
        { "id": "n12", "type": "show_char", "data": { "character_id": "villager", "expression": "front_idle", "position": "center", "transition": "fade", "next": "n13" } },
        { "id": "n13", "type": "dialogue", "data": { "character_id": "villager", "expression": "scheming", "text": "又一个新来的？我是守棋人。要通过新手村，先赢我一局象棋。", "next": "n14" } },
        { "id": "n14", "type": "dialogue", "data": { "character_id": "villager", "expression": "laughing", "text": "先手红棋，让与你。我倒要看看，你这新手有几分本事。", "next": "n15" } },
        { "id": "n15", "type": "jump", "data": { "target_scene_id": "scene_2", "target_node_id": "s2_n1" } }
      ]
    },
    {
      "id": "scene_2",
      "name": "对弈·象棋首战",
      "start_node_id": "s2_n1",
      "nodes": [
        { "id": "s2_n1", "type": "bg", "data": { "bg_id": "bg_board", "transition": "fade", "next": "s2_n2" } },
        { "id": "s2_n2", "type": "hide_char", "data": { "character_id": "robot", "transition": "fade", "next": "s2_n3" } },
        { "id": "s2_n3", "type": "hide_char", "data": { "character_id": "villager", "transition": "fade", "next": "s2_n4" } },
        { "id": "s2_n4", "type": "narration", "data": { "text": "楚河汉界既定，红黑列阵。小明执红先行，守棋人执黑在后。", "next": "s2_n5" } },
        { "id": "s2_n5", "type": "dialogue", "data": { "character_id": "villager", "expression": "scheming", "text": "请。", "next": "s2_n6" } },
        { "id": "s2_n6", "type": "end", "data": { "ending_type": "neutral", "text": "第 1 章·入门 开始" } }
      ]
    },
    {
      "id": "scene_3",
      "name": "战后·初胜",
      "start_node_id": "s3_n1",
      "nodes": [
        { "id": "s3_n1", "type": "bg", "data": { "bg_id": "bg_village", "transition": "fade", "next": "s3_n2" } },
        { "id": "s3_n2", "type": "show_char", "data": { "character_id": "villager", "expression": "defeat", "position": "center", "transition": "fade", "next": "s3_n3" } },
        { "id": "s3_n3", "type": "dialogue", "data": { "character_id": "villager", "expression": "surprised", "text": "……有意思。你的棋路……似乎不太寻常。", "next": "s3_n4" } },
        { "id": "s3_n4", "type": "show_char", "data": { "character_id": "boy", "expression": "victory", "position": "left", "transition": "fade", "next": "s3_n5" } },
        { "id": "s3_n5", "type": "dialogue", "data": { "character_id": "boy", "expression": "happy", "text": "我赢了！", "next": "s3_n6" } },
        { "id": "s3_n6", "type": "dialogue", "data": { "character_id": "villager", "expression": "thinking", "text": "你通过了新手村。沿着棋盘路继续往前走，你会遇到更强的对手。", "next": "s3_n7" } },
        { "id": "s3_n7", "type": "dialogue", "data": { "character_id": "robot", "expression": "laughing", "text": "不错的开局。但这只是开始——真正的挑战还在后面。", "next": "s3_n8" } },
        { "id": "s3_n8", "type": "dialogue", "data": { "character_id": "boy", "expression": "determined", "text": "我不怕。继续前进吧！", "next": "s3_n9" } },
        { "id": "s3_n9", "type": "end", "data": { "ending_type": "neutral", "text": "第 1 章·入门 完" } }
      ]
    }
  ]
