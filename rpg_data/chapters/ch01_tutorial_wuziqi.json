        { "id": "s2_n3", "type": "narration", "data": { "text": "棋盘浮现，黑白子对峙。少年执黑先行。", "next": "s2_n4" } },
        { "id": "s2_n4", "type": "dialogue", "data": { "character_id": "robot", "expression": "front_idle", "text": "这一局，我亲自陪你下。放马过来。", "next": "s2_n5" } },
