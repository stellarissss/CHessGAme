  "variables": {},
  "start_scene_id": "scene_1",
  "scenes": [
    {
      "id": "scene_1",
      "name": "棋圣空间·初遇",
      "start_node_id": "n1",
      "nodes": [
        { "id": "n1", "type": "bg", "data": { "bg_id": "bg_cyber", "transition": "fade", "next": "n2" } },
        { "id": "n2", "type": "narration", "data": { "text": "意识坠入一片幽蓝的数据虚空。悬浮的几何碎片缓缓旋转，似有无数棋局在远方回响。", "next": "n3" } },
        { "id": "n3", "type": "show_char", "data": { "character_id": "robot", "expression": "front_idle", "position": "center", "transition": "fade", "next": "n4" } },
        { "id": "n4", "type": "dialogue", "data": { "character_id": "robot", "expression": "scheming", "text": "欢迎来到棋圣空间。在这里，我将教你如何——赢得每一局棋。", "next": "n5" } },
        { "id": "n5", "type": "dialogue", "data": { "character_id": "boy", "expression": "surprised", "text": "……赢？可我连五子棋都下不好。", "next": "n6" } },
        { "id": "n6", "type": "dialogue", "data": { "character_id": "robot", "expression": "laughing", "text": "那是因为你太拘泥于「规则」。今天，我们换个玩法。", "next": "n7" } },
        { "id": "n7", "type": "dialogue", "data": { "character_id": "robot", "expression": "scheming", "text": "看好了——这是你的第一个对手：五子棋。先连成五子者胜，规则最简单。", "next": "n8" } },
        { "id": "n8", "type": "narration", "data": { "text": "虚空中央浮现一块悬浮的五子棋盘，黑白子静静对峙。", "next": "n9" } },
        { "id": "n9", "type": "dialogue", "data": { "character_id": "robot", "expression": "front_idle", "text": "但这只是表象。真正的胜负，不在棋盘上——而在你的右侧。", "next": "n10" } },
        { "id": "n10", "type": "jump", "data": { "target_scene_id": "scene_2", "target_node_id": "s2_n1" } }
      ]
    },
    {
      "id": "scene_2",
      "name": "教学·能量条",
      "start_node_id": "s2_n1",
      "nodes": [
        { "id": "s2_n1", "type": "dialogue", "data": { "character_id": "robot", "expression": "front_idle", "text": "请将视线移向屏幕顶部——那条发着青光的横条，便是「棋圣能量」。", "next": "s2_n2" } },
        { "id": "s2_n2", "type": "dialogue", "data": { "character_id": "robot", "expression": "scheming", "text": "起始为 0，最大 100。中间那道金色刻度是「使用门槛」——30。", "next": "s2_n3" } },
        { "id": "s2_n3", "type": "dialogue", "data": { "character_id": "robot", "expression": "thinking", "text": "如何获得能量？下棋即可。每次吃子 +10，被吃 +5；五子棋成五连 +15；每 5 回合被动 +2。", "next": "s2_n4" } },
        { "id": "s2_n4", "type": "dialogue", "data": { "character_id": "boy", "expression": "thinking", "text": "也就是说……认真下棋，能量就会涨？", "next": "s2_n5" } },
        { "id": "s2_n5", "type": "dialogue", "data": { "character_id": "robot", "expression": "laughing", "text": "正是。能量是你「打破规则」的筹码。攒得越多，能做的事就越离谱。", "next": "s2_n6" } },
        { "id": "s2_n6", "type": "dialogue", "data": { "character_id": "robot", "expression": "scheming", "text": "注意：能量允许透支。但透支越多，代价也越重——这点稍后我会告诉你。", "next": "s2_n7" } },
        { "id": "s2_n7", "type": "jump", "data": { "target_scene_id": "scene_3", "target_node_id": "s3_n1" } }
      ]
    },
    {
      "id": "scene_3",
      "name": "教学·棋圣系统",
      "start_node_id": "s3_n1",
      "nodes": [
        { "id": "s3_n1", "type": "dialogue", "data": { "character_id": "robot", "expression": "front_idle", "text": "现在看向屏幕右侧的紫色面板——这便是「棋圣系统」。", "next": "s3_n2" } },
        { "id": "s3_n2", "type": "dialogue", "data": { "character_id": "robot", "expression": "scheming", "text": "当能量 ≥30 时，你可以在文本框中输入任意「作弊指令」——用自然语言描述你想改写的规则。", "next": "s3_n3" } },
        { "id": "s3_n3", "type": "dialogue", "data": { "character_id": "boy", "expression": "surprised", "text": "自然语言？比如说……", "next": "s3_n4" } },
        { "id": "s3_n4", "type": "dialogue", "data": { "character_id": "robot", "expression": "laughing", "text": "比如：「让我的棋子连成五子」——直接获胜。", "next": "s3_n5" } },
        { "id": "s3_n5", "type": "dialogue", "data": { "character_id": "robot", "expression": "scheming", "text": "或：「冻结对手一回合」「把对方某子挪开」「让我多走一步」……", "next": "s3_n6" } },
        { "id": "s3_n6", "type": "dialogue", "data": { "character_id": "robot", "expression": "front_idle", "text": "流程是：输入指令 → 点击「评估消耗」查看耗能 → 点击「执行作弊」应用。也可用 Ctrl+Enter 快速评估。", "next": "s3_n7" } },
        { "id": "s3_n7", "type": "dialogue", "data": { "character_id": "boy", "expression": "thinking", "text": "听起来……太作弊了吧？对手不会察觉吗？", "next": "s3_n8" } },
        { "id": "s3_n8", "type": "jump", "data": { "target_scene_id": "scene_4", "target_node_id": "s4_n1" } }
      ]
    },
    {
      "id": "scene_4",
      "name": "教学·识破概率",
      "start_node_id": "s4_n1",
      "nodes": [
        { "id": "s4_n1", "type": "dialogue", "data": { "character_id": "robot", "expression": "scheming", "text": "好问题。这正是棋圣系统最精妙之处——「认知扭曲」。", "next": "s4_n2" } },
        { "id": "s4_n2", "type": "dialogue", "data": { "character_id": "robot", "expression": "laughing", "text": "你作弊时，对手的认知会被实时改写。他们会「合理化」你的违规，认为本该如此。", "next": "s4_n3" } },
        { "id": "s4_n3", "type": "dialogue", "data": { "character_id": "robot", "expression": "scheming", "text": "但这份扭曲并非无懈可击。每次作弊都会累积一个隐藏数值——「识破概率」。", "next": "s4_n4" } },
        { "id": "s4_n4", "type": "dialogue", "data": { "character_id": "robot", "expression": "front_idle", "text": "你无法在游戏中看到具体百分比——它是一个悬念。但你能感知到，它在不断攀升。", "next": "s4_n5" } },
        { "id": "s4_n5", "type": "dialogue", "data": { "character_id": "robot", "expression": "scheming", "text": "若被识破——结局将走向深渊。若全程未作弊——则另有隐藏结局。", "next": "s4_n6" } },
        { "id": "s4_n6", "type": "dialogue", "data": { "character_id": "boy", "expression": "determined", "text": "……我懂了。作弊有代价，但能赢；不作弊则靠真本事。", "next": "s4_n7" } },
        { "id": "s4_n7", "type": "dialogue", "data": { "character_id": "robot", "expression": "laughing", "text": "正是。这是一场关于「公平与胜利」的抉择。来吧，做出你的选择。", "next": "s4_n8" } },
        { "id": "s4_n8", "type": "choice", "data": { "options": [
          { "text": "我愿接受棋圣之力（启用作弊）", "next_scene_id": "scene_5", "next_node_id": "s5_accept" },
          { "text": "我想凭实力下棋（也可随时反悔）", "next_scene_id": "scene_5", "next_node_id": "s5_refuse" }
        ] } }
      ]
    },
    {
      "id": "scene_5",
      "name": "抉择·实战之约",
      "start_node_id": "s5_accept",
      "nodes": [
        { "id": "s5_accept", "type": "dialogue", "data": { "character_id": "robot", "expression": "victory", "text": "明智。能量条已激活，棋圣系统随时待命。", "next": "s5_jump" } },
        { "id": "s5_refuse", "type": "dialogue", "data": { "character_id": "robot", "expression": "scheming", "text": "呵……纯洁的选择。但棋圣系统不会消失——它只在等待你下次动摇。", "next": "s5_jump" } },
        { "id": "s5_jump", "type": "dialogue", "data": { "character_id": "robot", "expression": "front_idle", "text": "临行前再提醒你三件事——", "next": "s5_t1" } },
        { "id": "s5_t1", "type": "dialogue", "data": { "character_id": "robot", "expression": "thinking", "text": "其一：顶部「☰」可随时打开章节列表回顾。其二：顶部「?」可随时查阅游玩文档。", "next": "s5_t2" } },
        { "id": "s5_t2", "type": "dialogue", "data": { "character_id": "robot", "expression": "scheming", "text": "其三：右侧「重温教程」按钮可随时回到本章。", "next": "s5_t3" } },
        { "id": "s5_t3", "type": "dialogue", "data": { "character_id": "boy", "expression": "confident", "text": "明白了。这一局，我亲自下。", "next": "s5_t4" } },
        { "id": "s5_t4", "type": "jump", "data": { "target_scene_id": "scene_6", "target_node_id": "s6_n1" } }
      ]
    },
    {
      "id": "scene_6",
      "name": "开局",
      "start_node_id": "s6_n1",
      "nodes": [
        { "id": "s6_n1", "type": "bg", "data": { "bg_id": "bg_board", "transition": "fade", "next": "s6_n2" } },
        { "id": "s6_n2", "type": "hide_char", "data": { "character_id": "boy", "transition": "fade", "next": "s6_n3" } },
        { "id": "s6_n3", "type": "hide_char", "data": { "character_id": "robot", "transition": "fade", "next": "s6_n4" } },
        { "id": "s6_n4", "type": "narration", "data": { "text": "棋盘浮现，黑白子对峙。少年执黑先行。", "next": "s6_n5" } },
        { "id": "s6_n5", "type": "dialogue", "data": { "character_id": "robot", "expression": "front_idle", "text": "这一局，我亲自陪你下。点击棋盘落子，放马过来。", "next": "s6_n6" } },
        { "id": "s6_n6", "type": "end", "data": { "ending_type": "neutral", "text": "第 0 章·教程 开始" } }
      ]
    }
  ]
}
