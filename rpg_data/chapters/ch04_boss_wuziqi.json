  "scenes": [
    {
      "id": "scene_1",
      "name": "BOSS塔·暗影棋王",
      "start_node_id": "n1",
      "nodes": [
        { "id": "n1", "type": "bg", "data": { "bg_id": "bg_boss_tower", "transition": "fade", "next": "n2" } },
        { "id": "n2", "type": "narration", "data": { "text": "进阶区的尽头，一座高耸入云的黑色塔矗立在眼前。塔身刻满了诡异的棋盘纹路，散发着不祥的气息。", "next": "n3" } },
        { "id": "n3", "type": "show_char", "data": { "character_id": "boy", "expression": "determined", "position": "center", "transition": "fade", "next": "n4" } },
        { "id": "n4", "type": "dialogue", "data": { "character_id": "boy", "expression": "determined", "text": "这就是BOSS塔吗……不管里面有什么，我都要闯过去！", "next": "n5" } },
        { "id": "n5", "type": "dialogue", "data": { "character_id": "robot", "expression": "scheming", "text": "小心。这座塔里的守护者，是棋圣世界最强的棋手之一——暗影棋王。", "next": "n6" } },
        { "id": "n6", "type": "narration", "data": { "text": "塔门缓缓打开，一个身披黑袍的身影从中走出。他的眼中闪烁着紫色的光芒。", "next": "n7" } },
        { "id": "n7", "type": "show_char", "data": { "character_id": "boss", "expression": "scheming", "position": "center", "transition": "fade", "next": "n8" } },
        { "id": "n8", "type": "dialogue", "data": { "character_id": "boss", "expression": "laughing", "text": "呵呵呵……又一个不知天高地厚的挑战者。我是暗影棋王。", "next": "n9" } },
        { "id": "n9", "type": "dialogue", "data": { "character_id": "boss", "expression": "angry", "text": "想通过这座塔？先赢我一局五子棋——不过，我的五子棋规则有些不同。", "next": "n10" } },
        { "id": "n10", "type": "dialogue", "data": { "character_id": "boss", "expression": "scheming", "text": "普通五子棋是连成五子获胜，但我的规则——需要连成六子。你，敢挑战吗？", "next": "n11" } },
        { "id": "n11", "type": "show_char", "data": { "character_id": "boy", "expression": "surprised", "position": "center", "transition": "fade", "next": "n12" } },
        { "id": "n12", "type": "dialogue", "data": { "character_id": "boy", "expression": "surprised", "text": "六子？这……这不是更难了吗？", "next": "n13" } },
        { "id": "n13", "type": "dialogue", "data": { "character_id": "boss", "expression": "laughing", "text": "难？这才是真正的挑战。要是连这点难度都受不了，就滚回新手村去吧！", "next": "n14" } },
        { "id": "n14", "type": "dialogue", "data": { "character_id": "boy", "expression": "determined", "text": "我不会退缩的。六子就六子——来吧！", "next": "n15" } },
        { "id": "n15", "type": "bg", "data": { "bg_id": "bg_board", "transition": "fade", "next": "n16" } },
        { "id": "n16", "type": "end", "data": { "ending_type": "neutral", "text": "第 3 章·BOSS战 开始" } }
      ]
    },
    {
      "id": "scene_2",
      "name": "战后·破塔",
      "start_node_id": "s2_n1",
      "nodes": [
        { "id": "s2_n1", "type": "bg", "data": { "bg_id": "bg_boss_tower", "transition": "fade", "next": "s2_n2" } },
        { "id": "s2_n2", "type": "show_char", "data": { "character_id": "boss", "expression": "defeat", "position": "center", "transition": "fade", "next": "s2_n3" } },
        { "id": "s2_n3", "type": "dialogue", "data": { "character_id": "boss", "expression": "surprised", "text": "……不可能。你居然真的做到了……", "next": "s2_n4" } },
        { "id": "s2_n4", "type": "show_char", "data": { "character_id": "boy", "expression": "victory", "position": "left", "transition": "fade", "next": "s2_n5" } },
        { "id": "s2_n5", "type": "dialogue", "data": { "character_id": "boy", "expression": "happy", "text": "我赢了！", "next": "s2_n6" } },
        { "id": "s2_n6", "type": "dialogue", "data": { "character_id": "boss", "expression": "thinking", "text": "你通过了BOSS塔。但真正的考验还在后头——棋圣圣殿就在前方。", "next": "s2_n7" } },
        { "id": "s2_n7", "type": "dialogue", "data": { "character_id": "boss", "expression": "scheming", "text": "记住，棋圣真身……比我强百倍。", "next": "s2_n8" } },
        { "id": "s2_n8", "type": "dialogue", "data": { "character_id": "robot", "expression": "laughing", "text": "不错不错。暗影棋王都不是你的对手了。但别大意——棋圣真身才是终极挑战。", "next": "s2_n9" } },
        { "id": "s2_n9", "type": "dialogue", "data": { "character_id": "boy", "expression": "determined", "text": "我已经准备好了。前往棋圣圣殿！", "next": "s2_n10" } },
        { "id": "s2_n10", "type": "end", "data": { "ending_type": "neutral", "text": "第 3 章·BOSS战 完" } }
      ]
    }
  ]
